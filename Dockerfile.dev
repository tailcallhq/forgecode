# Dockerfile.dev — Forgecode development environment
# Python base image with Rust 1.97 toolchain, dev tools, and linters.
# Usage: docker compose -f docker-compose.dev.yml up --build
#
# ── Dependency pins (Scorecard PinnedDependencies) ───────────
# pinned 2026-08-27 — last reviewed against upstream registries.
#
# Source URLs for verification:
#   Base image    — https://hub.docker.com/_/python/tags?name=3.12-slim-bookworm
#   apt packages  — https://packages.debian.org/bookworm/<pkg>
#   rustup-init   — https://static.rust-lang.org/rustup/release-stable.toml
#                    https://github.com/rust-lang/rustup/releases/tag/1.29.0
#   cargo crates  — https://crates.io/api/v1/crates/<crate>/versions
#   nodejs deb    — https://github.com/nodesource/distributions
#   pypi packages — https://pypi.org/pypi/<pkg>/json
#
# Verify each pin by re-running the queries documented next to it.
# Update on a fixed cadence (or via Renovate) and bump the "pinned" date.

FROM python:3.12-slim-bookworm@sha256:0f5b26b9518d002b6173fd61daad821fa340635ebfec5bba471013f9ca114579 AS base

# ── System dependencies ───────────────────────────────────────
# Pinned versions verified against bookworm/main on 2026-08-27.
# Re-verify with: apt-cache policy <pkg>  (inside a debian:bookworm container)
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl=7.88.1-10+deb12u15 \
    build-essential=12.9 \
    pkg-config=1.8.1-1 \
    libssl-dev=3.0.20-1~deb12u2 \
    libffi-dev=3.4.4-1 \
    git=1:2.39.5-0+deb12u3 \
    ca-certificates=20230311+deb12u1 \
    && rm -rf /var/lib/apt/lists/*

# ── Rust toolchain (1.97, matching rust-toolchain.toml) ──────
# rustup-init binary pinned by SHA-256 to release 1.29.0 (current stable
# per https://static.rust-lang.org/rustup/release-stable.toml on 2026-08-27).
# The default toolchain  below intentionally tracks rust-toolchain.toml.
ENV RUSTUP_HOME=/usr/local/rustup \
    CARGO_HOME=/usr/local/cargo \
    PATH="/usr/local/cargo/bin:${PATH}"
RUN set -eux; \
    curl -fsSLo /tmp/rustup-init \
        https://static.rust-lang.org/rustup/dist/x86_64-unknown-linux-gnu/rustup-init; \
    echo "4acc9acc76d5079515b46346a485974457b5a79893cfb01112423c89aeb5aa10  /tmp/rustup-init" \
        | sha256sum -c -; \
    chmod +x /tmp/rustup-init; \
    /tmp/rustup-init -y \
        --default-toolchain 1.97 \
        --profile default \
        --component rustfmt,clippy \
        --no-modify-path; \
    rm /tmp/rustup-init; \
    chmod -R a+rX "$RUSTUP_HOME" "$CARGO_HOME"

# ── Cargo dev tools ──────────────────────────────────────────
# Pinned per crates.io metadata fetched on 2026-08-27:
#   cargo-deny     0.20.2   (<= https://crates.io/crates/cargo-deny/0.20.2)
#   cargo-nextest  0.9.143  (<= https://crates.io/crates/cargo-nextest/0.9.143)
#   cargo-watch    8.5.3    (<= https://crates.io/crates/cargo-watch/8.5.3)
RUN cargo install \
    cargo-deny@0.20.2 \
    cargo-nextest@0.9.143 \
    cargo-watch@8.5.3 \
    --locked

# ── Node.js 22.23.2 (for benchmarks/evals package.json) ──────
# Pinned by SHA-256 against the official NodeSource .deb (no shell-piped
# installer script). Filename encodes the Node version, providing an
# independent version assertion even if the SHA is stale.
#   Source : https://github.com/nodesource/distributions
#   Verified: 2026-08-27
RUN set -eux; \
    curl -fsSLo /tmp/nodejs.deb \
        https://deb.nodesource.com/node_22.x/pool/main/n/nodejs/nodejs_22.23.2-1nodesource1_amd64.deb; \
    echo "eed0c5f0ab411f28783f81f051fcf7928ae8bf833e2df11f48f3fa78270025cb  /tmp/nodejs.deb" \
        | sha256sum -c -; \
    apt-get update; \
    apt-get install -y --no-install-recommends /tmp/nodejs.deb; \
    rm /tmp/nodejs.deb; \
    rm -rf /var/lib/apt/lists/*

# ── Python dev dependencies ──────────────────────────────────
# Versions verified against PyPI JSON API on 2026-08-27. All artifacts
# pinned by --hash=sha256:<digest> in requirements/dev.txt, generated by
# scripts/gen_requirements_dev.py. pip --require-hashes refuses install
# if any resolved artifact's hash is missing or mismatched — this is the
# Scorecard PinnedDependencies hard guarantee.
#   pip==26.2.1 pytest==9.1.1 pytest-cov==7.1.0 pytest-xdist==3.8.0
#   ruff==0.16.5 mypy==2.3.1 pip-audit==2.10.1 build==1.6.0
#   pyyaml==6.0.3 requests==2.34.2
COPY requirements/ /workspace/requirements/
WORKDIR /workspace
RUN pip install --no-cache-dir --require-hashes -r requirements/dev.txt

# ── Pre-download dependencies when possible (layer caching) ──
# Copy manifests first for better layer caching
COPY Cargo.toml Cargo.lock rust-toolchain.toml clippy.toml ./
# requirements/ was already copied at L92; re-stating the COPY here would
# create a redundant layer. Skip.

# Pre-fetch Rust deps (will be invalidated on change)
RUN mkdir -p crates/forge_main/src && echo 'fn main() {}' > crates/forge_main/src/main.rs \
    && cargo fetch 2>/dev/null || true \
    && rm -rf crates/forge_main/src

# Pre-fetch Python deps via --require-hashes (Scorecard PinnedDependencies)
# Already installed at L94; this is a no-op safety net for build cache hits.
RUN pip install --no-cache-dir --require-hashes -r requirements/dev.txt 2>/dev/null || true

# Pre-fetch Node deps — npm ci is deterministic against package-lock.json
# (skipped here: no package.json at this layer; layer re-fetched at runtime if
#  benchmarks/evals need it)
RUN npm ci --no-audit --no-fund 2>/dev/null || true

# ── Default command: build + test watch ──────────────────────
CMD ["bash"]
